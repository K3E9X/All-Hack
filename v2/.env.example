# Copy to .env and fill in. Never commit .env.

# -----------------------------------------------------------------------------
# Postgres + Redis (used by docker-compose and the backend itself)
# -----------------------------------------------------------------------------
POSTGRES_DB=allhack
POSTGRES_USER=allhack
POSTGRES_PASSWORD=allhack
# DATABASE_URL is built automatically inside docker-compose; only set this if
# you run the backend outside docker.
# DATABASE_URL=postgresql://allhack:allhack@localhost:5432/allhack
# REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# LLM router - one client per role (Planner / Executor / Validator).
# All endpoints below are OpenAI-compatible Chat Completions APIs.
#
# Pick a provider for each role:
#
#   OpenRouter aggregator (default, free models available):
#       BASE_URL = https://openrouter.ai/api/v1
#       MODEL    = qwen/qwen3-coder:free            (or any other slug)
#
#   Z.ai (Zhipu GLM) - pay-as-you-go:
#       BASE_URL = https://api.z.ai/api/paas/v4
#       MODEL    = glm-4.6        (executor)
#       MODEL    = glm-5.1        (planner)
#
#   Moonshot (Kimi K2.6) - pay-as-you-go:
#       BASE_URL = https://api.moonshot.cn/v1
#       MODEL    = kimi-k2.6
#
# If a role's API key is empty, it falls back to the OPENROUTER_* config
# below. That preserves the Phase 0-3 behaviour out of the box.
# -----------------------------------------------------------------------------

PLANNER_BASE_URL=
PLANNER_API_KEY=
PLANNER_MODEL=

EXECUTOR_BASE_URL=
EXECUTOR_API_KEY=
EXECUTOR_MODEL=

VALIDATOR_BASE_URL=
VALIDATOR_API_KEY=
VALIDATOR_MODEL=

# -----------------------------------------------------------------------------
# OpenRouter fallback (also: default for any role left blank above).
# Get a key at https://openrouter.ai/keys (free models available).
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-coder:free
OPENROUTER_FALLBACK_MODELS=meta-llama/llama-3.3-70b-instruct:free,openai/gpt-oss-120b:free,qwen/qwen3-next-80b-a3b-instruct:free
OPENROUTER_APP_NAME=allhack

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------

# Allowed CORS origins for the API (comma-separated).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional. WPScan uses its own vulnerability database for CVE correlation.
# Free tier: 25 requests/day per address. https://wpscan.com/register
WPSCAN_API_TOKEN=
