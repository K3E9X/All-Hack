# Copy to .env and fill in. Never commit .env.

# OpenRouter API key. Get one at https://openrouter.ai/keys
# The default model below is free; you can switch to any OpenRouter model.
OPENROUTER_API_KEY=

# Default free model (Qwen3 Coder, strong at structured output and security
# reasoning). OpenRouter rotates which :free variants are available; if the
# default stops working, swap to any currently-available one. See the list:
#   curl -s https://openrouter.ai/api/v1/models | jq -r '.data[] | select(.id | endswith(":free")) | .id'
OPENROUTER_MODEL=qwen/qwen3-coder:free

# Comma-separated fallback chain. When the primary model returns 429/5xx
# (typically because the upstream provider is temporarily rate-limited),
# the client retries with the next model in this list, then the next, etc.
# Empty string disables fallback. The order below is what users get on a
# fresh install.
OPENROUTER_FALLBACK_MODELS=meta-llama/llama-3.3-70b-instruct:free,openai/gpt-oss-120b:free,qwen/qwen3-next-80b-a3b-instruct:free

# Optional: site name sent in OpenRouter headers (helps with their free quota).
OPENROUTER_APP_NAME=allhack

# Allowed CORS origins for the API (comma-separated). Frontend nginx proxies
# /api/ internally so the browser usually talks same-origin; this is for
# direct-API access during development.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
