# API Configuration
API_TITLE=Advanced Pentest Tool
API_VERSION=1.0.0
API_PREFIX=/api/v1

# CORS - Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Scanning Configuration
MAX_CONCURRENT_SCANS=5
SCAN_TIMEOUT=43200
REQUEST_TIMEOUT=60
MAX_RETRIES=5

# SSL/TLS Configuration
# Set to true to enable SSL certificate verification (recommended for production)
# Set to false for pentesting targets with self-signed or invalid certificates
VERIFY_SSL=false

# User Agent
USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# ==================================
# AI Agent Configuration (NEW!)
# ==================================
# Get your API key from: https://console.anthropic.com/
# The AI agent analyzes scan results in real-time and decides which tests to run next
ANTHROPIC_API_KEY=your-claude-api-key-here
ENABLE_AI_AGENT=false
AI_AGENT_MAX_ITERATIONS=10

# ==================================
# Email Notifications (NEW!)
# ==================================
# SMTP Server Configuration
# For Gmail: use smtp.gmail.com with an App Password (not your regular password)
# Get App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true

# Notification Recipients
NOTIFICATION_EMAIL_FROM=pentest-bot@yourcompany.com
NOTIFICATION_EMAIL_TO=security-team@yourcompany.com

# ==================================
# Webhook/Slack Notifications (NEW!)
# ==================================
# Optional: Webhook URL for custom integrations
NOTIFICATION_WEBHOOK_URL=https://your-webhook.com/notify

# Optional: Slack incoming webhook URL
# Get yours from: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ==================================
# Frontend Configuration
# ==================================
FRONTEND_URL=http://localhost:5173
